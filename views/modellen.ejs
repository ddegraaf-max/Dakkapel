<%- include('partials/header', { title: 'Modellen' }) %>

<section class="page-hero">
  <div class="container">
    <span class="kicker">Onze modellen</span>
    <h1>Vier dakkapellen, elk op maat gebouwd.</h1>
    <p>Kies het model dat bij uw woning past — elk model is leverbaar in meerdere kleuren en breedtes, en wordt altijd op maat gemaakt. Opslag per extra meter: € 1.000,- inclusief BTW.</p>
  </div>
</section>

<section class="section" style="padding-top:20px">
  <div class="container">
    <div class="type-compare" style="grid-template-columns:1fr 1fr">
      <% 
      const SWATCH = { wit:'#f5f5f2', creme:'#efe9d8', antraciet:'#3a4045', bruin:'#7a5230', monument:'#27453a' };
      const KLEUR = { wit:'Verkeerswit', creme:'Crèmewit', antraciet:'Antraciet houtnerf', bruin:'Houtlook bruin', monument:'Monumentengroen' };
      models.forEach(function(m){
        const kozijn = m.colors[0] === 'antraciet' ? '#3a4045' : (m.colors[0] === 'bruin' ? '#7a5230' : '#e9e9e4');
      %>
      <div class="type-card reveal" id="<%= m.slug %>">
        <div class="type-illu">
          <svg viewBox="0 0 400 180" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <polygon points="30,170 200,40 370,170" fill="#7a564a" stroke="#22272b" stroke-width="3"/>
            <% if (m.type === 'aangekapt') { %>
            <polygon points="110,92 200,52 290,92" fill="#5b4038" stroke="#22272b" stroke-width="3"/>
            <rect x="118" y="92" width="164" height="54" fill="#faf6f0" stroke="#22272b" stroke-width="3"/>
            <rect x="128" y="100" width="42" height="38" fill="#bcd7e8" stroke="<%= kozijn %>" stroke-width="4"/>
            <rect x="179" y="100" width="42" height="38" fill="#bcd7e8" stroke="<%= kozijn %>" stroke-width="4"/>
            <rect x="230" y="100" width="42" height="38" fill="#bcd7e8" stroke="<%= kozijn %>" stroke-width="4"/>
            <% } else { %>
            <rect x="118" y="88" width="164" height="58" fill="#faf6f0" stroke="#22272b" stroke-width="3"/>
            <rect x="112" y="80" width="176" height="10" rx="3" fill="<%= m.material === 'hout' ? '#7a5230' : '#3a4045' %>"/>
            <rect x="128" y="97" width="42" height="40" fill="#bcd7e8" stroke="<%= kozijn %>" stroke-width="4"/>
            <rect x="179" y="97" width="42" height="40" fill="#bcd7e8" stroke="<%= kozijn %>" stroke-width="4"/>
            <rect x="230" y="97" width="42" height="40" fill="#bcd7e8" stroke="<%= kozijn %>" stroke-width="4"/>
            <% } %>
          </svg>
        </div>
        <div class="type-body">
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px">
            <h3><%= m.name %></h3>
            <span style="font-family:var(--font-display);font-size:1.35rem;font-weight:600;color:var(--accent);white-space:nowrap">v.a. € <%= m.price.toLocaleString('nl-NL') %></span>
          </div>
          <p style="margin-top:4px;color:var(--ink-mute);font-size:.88rem"><%= m.subtitle %> · casco prijs bij 2,50 meter, incl. BTW, lift en container</p>
          <p><%= m.desc %></p>
          <div style="display:flex;align-items:center;gap:8px;margin:14px 0 18px;flex-wrap:wrap">
            <span style="font-size:.82rem;font-weight:600;color:var(--ink-soft)">Kleuren:</span>
            <% m.colors.forEach(function(c){ %>
              <span title="<%= KLEUR[c] %>" style="display:inline-flex;align-items:center;gap:6px;font-size:.82rem;color:var(--ink-soft)">
                <span style="width:18px;height:18px;border-radius:6px;border:1px solid rgba(0,0,0,.15);background:<%= SWATCH[c] %>"></span><%= KLEUR[c] %>
              </span>
            <% }); %>
          </div>
          <a href="/configurator" class="btn btn-primary" style="padding:12px 24px;font-size:.94rem">Dit model samenstellen</a>
        </div>
      </div>
      <% }); %>
    </div>
    <p style="margin-top:34px;color:var(--ink-mute);font-size:.92rem">Prijzen zijn indicatief en kunnen variëren afhankelijk van de specifieke eisen en de grootte van het project. Voor een gedetailleerde offerte, <a href="/contact" style="text-decoration:underline">neem contact met ons op</a>.</p>
  </div>
</section>

<section class="section section-dark cta-band">
  <div class="container">
    <h2>Twijfelt u tussen <em>twee modellen</em>?</h2>
    <p>In de configurator wisselt u met één klik van type, materiaal en kleur — en ziet u direct het prijsverschil.</p>
    <a href="/configurator" class="btn btn-primary">Naar de configurator</a>
  </div>
</section>

<%- include('partials/footer') %>
