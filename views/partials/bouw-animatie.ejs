<section class="section" id="bouwanimatie">
  <div class="container">
    <div class="section-head">
      <span class="kicker">Zo bouwen wij</span>
      <h2>Gebouwd in onze werkplaats, in één dag geplaatst.</h2>
      <p>Uw dakkapel wordt na het inmeten compleet opgebouwd in onze eigen werkplaats — droog, gecontroleerd en exact op maat. Op de plaatsingsdag maken we de opening in het dak en hijsen we de dakkapel in één geheel op uw woning. 's Avonds is alles wind- en waterdicht.</p>
    </div>
    <div class="anim-wrap reveal">
      <svg id="buildAnim" viewBox="0 0 640 400" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Animatie: prefab dakkapel wordt in één dag met een kraan op het dak geplaatst">
        <defs>
          <linearGradient id="ba-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#dce9f2"/><stop offset="1" stop-color="#f4efe6"/></linearGradient>
          <linearGradient id="ba-roof" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5b4038"/><stop offset="1" stop-color="#7a564a"/></linearGradient>
          <pattern id="ba-tiles" width="26" height="14" patternUnits="userSpaceOnUse">
            <path d="M0 14 Q6.5 8 13 14 T26 14" stroke="rgba(0,0,0,.18)" fill="none"/>
          </pattern>
        </defs>
        <rect width="640" height="400" fill="url(#ba-sky)"/>
        <circle cx="552" cy="62" r="30" fill="#f2c98c" opacity=".85"/>

        <!-- woning -->
        <rect x="140" y="238" width="360" height="130" fill="#e9e2d4" stroke="#22272b" stroke-width="3"/>
        <polygon points="118,238 320,100 522,238" fill="url(#ba-roof)" stroke="#22272b" stroke-width="3"/>
        <polygon points="118,238 320,100 522,238" fill="url(#ba-tiles)"/>
        <rect x="188" y="272" width="52" height="60" fill="#bcd7e8" stroke="#22272b" stroke-width="3"/>
        <rect x="398" y="272" width="52" height="60" fill="#bcd7e8" stroke="#22272b" stroke-width="3"/>
        <rect x="298" y="280" width="44" height="88" fill="#c4502e" stroke="#22272b" stroke-width="3"/>
        <circle cx="332" cy="326" r="3" fill="#22272b"/>
        <rect x="0" y="366" width="640" height="34" fill="#9fb48a"/>

        <!-- plaatsingsdag: opening in het dak -->
        <g class="ph ph1">
          <rect x="248" y="152" width="144" height="72" fill="#2b2119" stroke="#22272b" stroke-width="2.5"/>
          <line x1="256" y1="160" x2="384" y2="216" stroke="rgba(255,255,255,.08)" stroke-width="2"/>
          <line x1="384" y1="160" x2="256" y2="216" stroke="rgba(255,255,255,.08)" stroke-width="2"/>
        </g>

        <!-- losse dakpannen naast de opening -->
        <g class="ph phTegels">
          <rect x="404" y="196" width="26" height="12" rx="2" fill="#7a564a" stroke="#22272b" stroke-width="1.5" transform="rotate(8 417 202)"/>
          <rect x="412" y="212" width="26" height="12" rx="2" fill="#6a4b40" stroke="#22272b" stroke-width="1.5" transform="rotate(-6 425 218)"/>
        </g>

        <!-- trailer: de dakkapel komt kant-en-klaar uit de werkplaats -->
        <g class="ph phTrailer">
          <rect x="4" y="354" width="136" height="9" rx="2" fill="#5f666c" stroke="#22272b" stroke-width="1.5"/>
          <rect x="0" y="344" width="9" height="12" rx="1" fill="#5f666c" stroke="#22272b" stroke-width="1.5"/>
          <circle cx="36" cy="369" r="8" fill="#22272b"/>
          <circle cx="58" cy="369" r="8" fill="#22272b"/>
          <text x="72" y="382" font-family="Instrument Sans, sans-serif" font-size="11" font-weight="600" fill="#22272b" opacity=".7">uit de werkplaats</text>
        </g>

        <!-- mobiele kraan -->
        <g class="ph phKraan">
          <line x1="588" y1="336" x2="322" y2="12" stroke="#e3b53a" stroke-width="10" stroke-linecap="round"/>
          <line x1="588" y1="336" x2="322" y2="12" stroke="#22272b" stroke-width="1.5" opacity=".35" stroke-dasharray="7 7"/>
          <rect x="520" y="334" width="112" height="22" rx="4" fill="#e3b53a" stroke="#22272b" stroke-width="2"/>
          <rect x="528" y="314" width="42" height="22" rx="3" fill="#3a4045" stroke="#22272b" stroke-width="2"/>
          <rect x="534" y="319" width="14" height="10" fill="#bcd7e8"/>
          <line x1="524" y1="350" x2="506" y2="366" stroke="#22272b" stroke-width="3"/>
          <line x1="628" y1="350" x2="646" y2="366" stroke="#22272b" stroke-width="3"/>
          <circle cx="544" cy="362" r="9" fill="#22272b"/>
          <circle cx="612" cy="362" r="9" fill="#22272b"/>
          <circle cx="320" cy="12" r="4" fill="#22272b"/>
        </g>

        <!-- hijskabel + hijsbanden: dakkapel in de lucht -->
        <g class="ph phCableAir">
          <line x1="320" y1="12" x2="320" y2="36" stroke="#22272b" stroke-width="2"/>
          <path d="M320 36 L252 44 M320 36 L388 44" stroke="#22272b" stroke-width="2" fill="none"/>
        </g>
        <!-- hijskabel + hijsbanden: dakkapel op zijn plek -->
        <g class="ph phCablePlaced">
          <line x1="320" y1="12" x2="320" y2="132" stroke="#22272b" stroke-width="2"/>
          <path d="M320 132 L252 140 M320 132 L388 140" stroke="#22272b" stroke-width="2" fill="none"/>
        </g>

        <!-- de prefab dakkapel: één compleet element (zijwangen, kozijn, glas, dak, dorpel) -->
        <g class="ph phUnit pos-ground">
          <polygon points="248,158 236,224 248,224" fill="#cfc7b8" stroke="#22272b" stroke-width="2"/>
          <polygon points="392,158 404,224 392,224" fill="#cfc7b8" stroke="#22272b" stroke-width="2"/>
          <rect x="248" y="152" width="144" height="72" fill="#f5f5f2" stroke="#22272b" stroke-width="3"/>
          <rect x="258" y="160" width="36" height="54" fill="#bcd7e8" stroke="#e6e6e1" stroke-width="4"/>
          <rect x="302" y="160" width="36" height="54" fill="#bcd7e8" stroke="#e6e6e1" stroke-width="4"/>
          <rect x="346" y="160" width="36" height="54" fill="#bcd7e8" stroke="#e6e6e1" stroke-width="4"/>
          <rect x="240" y="138" width="160" height="14" rx="4" fill="#3a4045" stroke="#22272b" stroke-width="2.5"/>
          <line x1="246" y1="141" x2="394" y2="141" stroke="rgba(255,255,255,.35)" stroke-width="1.5"/>
          <polygon points="248,224 238,238 402,238 392,224" fill="#d9d2c3" stroke="#22272b" stroke-width="2.5"/>
        </g>

        <!-- afwerking: loodwerk en pannen aansluiten -->
        <g class="ph phLood">
          <polygon points="236,162 229,230 239,230 245,162" fill="#8d949b" stroke="#22272b" stroke-width="1"/>
          <polygon points="395,162 401,230 411,230 404,162" fill="#8d949b" stroke="#22272b" stroke-width="1"/>
          <rect x="232" y="237" width="176" height="6" rx="2" fill="#8d949b" stroke="#22272b" stroke-width="1.2"/>
        </g>

        <!-- vinkje bij oplevering -->
        <g class="ph ph5">
          <circle cx="540" cy="150" r="26" fill="#2e7d4f"/>
          <path d="M528 150 l8 9 l16 -18" stroke="#fff" stroke-width="4.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </g>
      </svg>
      <div class="anim-bar">
        <div class="anim-caption" id="animCaption">Uw woning — nog zonder dakkapel</div>
        <div class="anim-dots" id="animDots" aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>
